<div class="header-search" aria-label="Search" data-header-search>
  <label class="header-search-box">
    <span class="sr-only">Search notes by tag</span>
    <input data-search-input type="search" placeholder="Enter keywords" autocomplete="off" />
  </label>
  <div class="search-popover" data-search-popover hidden>
    <div data-search-status class="search-status">Select a tag</div>
    <div data-search-results class="search-results"></div>
  </div>
</div>

<script>
  import MiniSearch from "minisearch";
  import { articleMatchesSearchFilter } from "../lib/article-search-filter";
  import { openMobileSearchSidebar, shouldShowSearchTags } from "../lib/mobile-search-sidebar";
  import { collectSearchTags } from "../lib/search-tags";
  import { buildSearchQuery, searchOptions, tokenizeSearchText } from "../lib/search-tokenize";

  const input = document.querySelector("[data-search-input]");
  const popover = document.querySelector("[data-search-popover]");
  const resultsContainer = document.querySelector("[data-search-results]");
  const status = document.querySelector("[data-search-status]");

  if (
    input instanceof HTMLInputElement &&
    popover instanceof HTMLElement &&
    resultsContainer instanceof HTMLElement &&
    status instanceof HTMLElement
  ) {
    const searchInput = input;
    const searchPopover = popover;
    const searchResults = resultsContainer;
    const searchStatus = status;
    const response = await fetch(`${import.meta.env.BASE_URL}search-index.json`);
    const documents = await response.json();
    const tags = collectSearchTags(documents);
    const search = new MiniSearch({
      fields: ["title", "description", "tags", "body"],
      storeFields: ["title", "description", "url", "filePath", "body"],
      tokenize: tokenizeSearchText,
      searchOptions,
    });
    let selectedTag = "";

    search.addAll(documents);

    renderTags(tags);
    filterArticles();

    searchInput.addEventListener("focus", () => {
      renderPopoverState();
      openArticlesOnMobile();
    });
    searchInput.addEventListener("blur", renderPopoverState);
    searchInput.addEventListener("input", () => {
      selectedTag = "";
      filterArticles();
      renderPopoverState();
    });

    function filterArticles() {
      const filter = searchInput.value;
      const links = document.querySelectorAll("[data-article-link]");
      const query = buildSearchQuery(filter);
      const resultIds = new Set(search.search(query).map((result) => String(result.id)));
      let visibleCount = 0;

      for (const link of links) {
        const tags = JSON.parse(link.getAttribute("data-article-tags") ?? "[]");
        const id = link.getAttribute("data-article-id") ?? "";
        const isVisible =
          Array.isArray(tags) && articleMatchesSearchFilter({ id, tags }, filter, resultIds, selectedTag);
        if (link instanceof HTMLElement) {
          link.hidden = !isVisible;
        }
        if (isVisible) visibleCount += 1;
      }

      searchStatus.textContent = filter.trim() ? `${visibleCount} article${visibleCount === 1 ? "" : "s"}` : "Select a tag";
    }

    function renderTags(tagList: string[]) {
      searchResults.replaceChildren();

      for (const tag of tagList) {
        const button = document.createElement("button");
        button.className = "search-tag";
        button.type = "button";
        button.textContent = tag;
        button.addEventListener("pointerdown", (event) => {
          event.preventDefault();
          event.stopPropagation();
          selectedTag = tag;
          searchInput.value = tag;
          filterArticles();
          renderPopoverState();
          openArticlesOnMobile();
        });
        searchResults.append(button);
      }
    }

    function openArticlesOnMobile() {
      const shell = document.querySelector("[data-shell]");
      const isMobile = window.matchMedia("(max-width: 820px)").matches;
      openMobileSearchSidebar(shell instanceof HTMLElement ? shell : null, isMobile);
    }

    function renderPopoverState() {
      searchPopover.hidden = !shouldShowSearchTags(searchInput.value, document.activeElement === searchInput);
    }
  }
</script>
