---
import ArticleList from "../components/ArticleList.astro";
import ArticleOutline from "../components/ArticleOutline.astro";
import TopBar from "../components/TopBar.astro";
import "../styles/global.css";
import type { NoteRecord } from "../lib/notes";
import type { MarkdownHeading } from "astro";

type Props = {
  notes: NoteRecord[];
  currentNote?: NoteRecord;
  headings?: MarkdownHeading[];
};

const { notes, currentNote, headings = [] } = Astro.props;
const pageTitle = currentNote ? `${currentNote.title} - notes-site` : "notes-site";

function formatDate(date: Date | undefined) {
  return date ? date.toISOString().slice(0, 10) : "";
}

function formatFilePath(filePath: string) {
  return filePath.replace(/^src\/content\/notes\//, "");
}
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={currentNote?.description || "Markdown notes site"} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell" data-shell>
      <TopBar />
      <aside class="sidebar" data-sidebar>
        <div class="sidebar-tabs" role="tablist" aria-label="Sidebar views">
          <button class="sidebar-tab is-active" type="button" data-tab-button="articles">Articles</button>
          <button class="sidebar-tab" type="button" data-tab-button="outline">Outline</button>
        </div>

        <section class="sidebar-panel is-active" data-tab-panel="articles">
          <ArticleList notes={notes} currentSlug={currentNote?.slug} />
        </section>
        <section class="sidebar-panel" data-tab-panel="outline">
          <ArticleOutline headings={headings} />
        </section>
      </aside>

      <main class="content-shell">
        {
          currentNote ? (
            <article class="note-article">
              <div class="note-header">
                <p class="note-file">
                  <span>{formatFilePath(currentNote.filePath)}</span>
                  {formatDate(currentNote.created) && (
                    <time datetime={formatDate(currentNote.created)}>created {formatDate(currentNote.created)}</time>
                  )}
                  {formatDate(currentNote.updated) && (
                    <time datetime={formatDate(currentNote.updated)}>updated {formatDate(currentNote.updated)}</time>
                  )}
                </p>
                <h1>{currentNote.title}</h1>
                {currentNote.description && <p class="note-description">{currentNote.description}</p>}
              </div>
              <slot />
            </article>
          ) : (
            <article class="note-article empty-note">
              <h1>No notes found</h1>
              <p>Add Markdown files to <code>src/content/notes/</code>.</p>
            </article>
          )
        }
      </main>
    </div>

    <script>
      import { shouldKeepMobileSidebarOpen } from "../lib/mobile-search-sidebar";

      const shell = document.querySelector("[data-shell]");
      const tabButtons = document.querySelectorAll("[data-tab-button]");
      const tabPanels = document.querySelectorAll("[data-tab-panel]");

      for (const button of tabButtons) {
        button.addEventListener("click", () => {
          const target = button.getAttribute("data-tab-button");

          for (const item of tabButtons) {
            item.classList.toggle("is-active", item === button);
          }

          for (const panel of tabPanels) {
            panel.classList.toggle("is-active", panel.getAttribute("data-tab-panel") === target);
          }
        });
      }

      document.addEventListener("pointerdown", (event) => {
        if (!(event.target instanceof Element)) return;
        if (shouldKeepMobileSidebarOpen(event.target)) return;
        shell?.classList.remove("is-sidebar-open");
      });

      const outlineLinks = [...document.querySelectorAll(".outline-link")];
      const headings = outlineLinks
        .map((link) => document.getElementById(link.getAttribute("href")?.slice(1) ?? ""))
        .filter((heading): heading is HTMLElement => heading instanceof HTMLElement);

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

          if (!visible) return;

          for (const link of outlineLinks) {
            link.classList.toggle("is-current", link.getAttribute("href") === `#${visible.target.id}`);
          }
        },
        { rootMargin: "-10% 0px -70% 0px", threshold: [0, 1] },
      );

      for (const heading of headings) {
        observer.observe(heading);
      }
    </script>
  </body>
</html>
