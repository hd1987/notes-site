---
import { render } from "astro:content";
import NoteLayout from "../layouts/NoteLayout.astro";
import { getNoteContent } from "../lib/content";

const { entries, notes } = await getNoteContent();
const currentNote = notes[0];
const currentEntry = currentNote ? entries.find((entry) => entry.id === currentNote.id) : undefined;
const rendered = currentEntry ? await render(currentEntry) : undefined;
const Content = rendered?.Content;
---

<NoteLayout notes={notes} currentNote={currentNote} headings={rendered?.headings ?? []}>
  {Content && <Content />}
</NoteLayout>
