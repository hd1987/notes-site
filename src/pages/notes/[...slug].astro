---
import { render } from "astro:content";
import NoteLayout from "../../layouts/NoteLayout.astro";
import { getNoteContent } from "../../lib/content";
import { findNoteBySlug } from "../../lib/notes";

export async function getStaticPaths() {
  const { notes } = await getNoteContent();

  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { noteId: note.id },
  }));
}

const { entries, notes } = await getNoteContent();
const currentNote = findNoteBySlug(notes, Astro.params.slug ?? "");
const currentEntry = entries.find((entry) => entry.id === Astro.props.noteId);
const rendered = currentEntry ? await render(currentEntry) : undefined;
const Content = rendered?.Content;
---

<NoteLayout notes={notes} currentNote={currentNote} headings={rendered?.headings ?? []}>
  {Content && <Content />}
</NoteLayout>
